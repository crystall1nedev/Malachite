    "settings.detail.photo.continuous" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the options you would like the camera to automatically monitor and adjust based on camera conditions, or disable it entirely."
          }
        }
      }
    },
    "settings.detail.photo.fileformat" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose JPEG for an older standard that is more widely accepted. Choose HEIC if you want a smaller file that works best on other Apple devices. Support for other file formats is coming in a future commit."
          }
        }
      }
    },
    "settings.detail.photo.hdr" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this if you want to include high dynamic range in your image. "
          }
        }
      }
    },
    "settings.detail.preview.aspect_ratio" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Fit to bounds to see all of the preview. Choose Fit if you want a more immersive shooting experience."
          }
        }
      }
    },
    "settings.detail.preview.sbtlz" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this if you want to stabilize the preview."
          }
        }
      }
    },
    "settings.detail.preview.zoom_maximum" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a higher zoom level to look even closer. Zoom levels that are out of optical zoom range will cause degradation in quality."
          }
        }
      }
    },
    "settings.detail.resolution.telephoto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a higher resolution for the telephoto camera to shoot in. "
          }
        }
      }
    },
    "settings.detail.resolution.ultrawide" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a higher resolution for the ultra wide camera to shoot in. Support for 48MP depends on your hardware, see the Compatibility page for more information."
          }
        }
      }
    },
    "settings.detail.resolution.wide" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a higher resolution for the wide angle camera to shoot in. Support for 12MP and 48MP depends on your hardware, see the Compatibility page for more information."
          }
        }
      }
    },
    "settings.detail.ui.haptics" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this if you want to disable mlchtCamera’s haptic feedback on buttons and gestures."
          }
        }
      }
    },
    "settings.detail.ui.hiddengestures" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the options you would like to have available while the user interface is hidden (two-finger tap and hold gesture.)"
          }
        }
      }
    },
    "settings.detail.ui.hiddenonlaunch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this to hide the user interface when mlchtCamera opens, useful for using the app as a magnifier."
          }
        }
      }
    },
    "settings.detail.ui.idletimer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this if you want to disable the system’s built-in auto lock timer while your device is stationary."
          }
        }
      }
    },
    "settings.detail.ui.tapgesture" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the options you would like to use when tapping and holding on the camera preview."
          }
        }
      }
    },
    "settings.detail.watermark.enable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this if you want to enable mlchtCamera's watermarking feature. Great for adding credits or details about the camera."
          }
        }
      }
    },
    "settings.detail.watermark.text" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
